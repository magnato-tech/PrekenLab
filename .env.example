# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPEN_TTS_BACKEND_URL: URL til din egen åpne Python / Chatterbox AI-backend (f.eks. http://localhost:8000 eller GPU-server).
# Kan også konfigureres direkte i brukergrensesnittet i TaleLab.
OPEN_TTS_BACKEND_URL="http://localhost:8000"
